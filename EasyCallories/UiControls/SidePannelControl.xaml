<UserControl x:Class="EasyCallories.UiControls.SidePannelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyCallories.UiControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Padding="8" Margin="0,0,0,5" Background="#585858" BorderThickness="3" CornerRadius="8">
            <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                <Button Content="Home" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SwitchViewCommand}" Margin="0,0,0,8" CommandParameter="Home"/>
                <Button Content="Cal in meal" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SwitchViewCommand}" Margin="0,0,0,8" CommandParameter="CalInMeal"/>
                <Button Content="Settings" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SwitchViewCommand}" Margin="0,0,0,8" CommandParameter="Settings"/>
                <Button Content="About" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SwitchViewCommand}" Margin="0,0,0,8" CommandParameter="About"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
