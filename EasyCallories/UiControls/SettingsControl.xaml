<UserControl x:Class="EasyCallories.UiControls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyCallories.UiControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Border Padding="8" Margin="0,5,0,0" Background="#585858" BorderThickness="3" CornerRadius="8">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <Label x:Name="targetCalLabel" Content="{Binding NewCalTarget}" Style="{StaticResource MaterialDesignLabel}" Foreground="Azure" FontSize="18"/>
                    <TextBox x:Name="targetCalInput" Text="{Binding SetNewCalTargetString, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting" Style="{StaticResource MaterialDesignOutlinedTextBox}" Background="AliceBlue" Height="30" Margin="0,0,0,4" Foreground="Black" Padding="3"/>
                <Button x:Name="TargetCalButton" Content="Set Cal Target" Command="{Binding SetNewTargetCommand}"/>
            </StackPanel>
        </Border>

        </StackPanel>

    </Grid>
</UserControl>
