<UserControl x:Class="EasyCallories.UiControls.HomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyCallories.UiControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Border Padding="8" Margin="0,4,0,5" Background="#585858" BorderThickness="3" CornerRadius="8">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <Label Content="{Binding TargetCal}" Style="{StaticResource MaterialDesignLabel}" Foreground="Azure" FontSize="18"/>
                    <Label Content="{Binding UsedCal}" Style="{StaticResource MaterialDesignLabel}" Foreground="Azure" FontSize="18"/>
                    <Label Content="{Binding CalLeft}" Style="{StaticResource MaterialDesignLabel}" Margin="0,0,0,15" Foreground="Azure" FontSize="18"/>
                    <Label Content="Add Calories " Style="{StaticResource MaterialDesignLabel}" />
                    <TextBox Text="{Binding AddCaloriesToUsedCaloriesUserInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Background="AliceBlue" Height="30" Margin="0,0,0,4" Foreground="Black" Padding="3" />
                    <Button Content="ADD" Command="{Binding AddCaloriesCommand}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
